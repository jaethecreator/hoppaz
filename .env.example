# Supabase: Project Settings -> API
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_...

# The public address of the site, no trailing slash (https://your-domain.example). Set this in production
# so OAuth callbacks and link previews always use the canonical domain (not a preview or local URL).
NEXT_PUBLIC_SITE_URL=

# Secret key. Server only, never prefixed NEXT_PUBLIC. Legacy projects can use
# SUPABASE_SERVICE_ROLE_KEY until they have created a Supabase secret key.
SUPABASE_SECRET_KEY=sb_secret_...

# Shared secret for the moderation endpoint at /api/admin/events
HOPPAZ_ADMIN_TOKEN=change-me

# Basemap tiles. The CARTO dark-matter style needs no key and is the default.
# Swap in a MapTiler or Protomaps style URL here if you outgrow the free tier.
NEXT_PUBLIC_MAP_STYLE=https://basemaps.cartocdn.com/gl/dark-matter-gl-style/style.json

# Spawn alerts (web push). Make a NEW pair for each environment:
#   node -e 'const w=require("web-push");console.log(w.generateVAPIDKeys())'
# The public key is inlined into the client bundle, so redeploy after changing it.
# PUSH_SEND_SECRET is a long random string, also given to the database with
# set_push_config('send_secret', ...). See docs/PUSH.md.
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:support@your-domain.example
PUSH_SEND_SECRET=

# Public privacy contact shown in the in-app privacy notice. Set this before launch.
NEXT_PUBLIC_SUPPORT_EMAIL=privacy@your-domain.example

# Game Time practice hunt ("How to hunt"): a 20 second lesson in how to search, played on the phone only (no server call, no
# real box, no code). Unset: ON in development, OFF in production. 1 or true: on. 0, false or off: off (the banner link, the
# hub link, the nudge and the first-visit practice all go). Inlined at build time, so redeploy after changing it. docs/GAME-TIME.md section 10.
NEXT_PUBLIC_HUNT_DEMO=

# Sound effects (ElevenLabs), only for scripts/sfx/. Server side tooling, never prefixed NEXT_PUBLIC. Leave empty here;
# put the real key in .env.local only (see docs/SOUND-FILES.md).
ELEVENLABS_API_KEY=

# Crew room voice. All dark until set. Names only here: put the values in .env.local / the host, never in git.
# NEXT_PUBLIC_ROOM_VOICE=1              area voice in the crew room (needs the three LIVEKIT_* below)
# NEXT_PUBLIC_ROOM_VOICE_AUTO=0        with voice on, walking in joins as a listener by itself; 0 goes back to tap to join
# NEXT_PUBLIC_ROOM_STAGE_VOICE=1        staff (owner and admins) on the stage talk to the whole room
# ROOM_VOICE_STAGE_ONLY=1               with the line above: only staff on the stage may publish; everyone else listens
# LIVEKIT_URL=
# LIVEKIT_API_KEY=
# LIVEKIT_API_SECRET=

# Release 1, free events and a community (all off by default; nothing changes for live users).
# NEXT_PUBLIC_EVENTS_R1=1 turns on the new event screens. NEXT_PUBLIC_EVENTS_R1_FAKE=1 uses seeded in-memory data (no database).
# NEXT_PUBLIC_ROOMS_SEAL=1 seals home base and every hotspot; Hoppaz HQ is the one central room.
NEXT_PUBLIC_EVENTS_R1=
NEXT_PUBLIC_EVENTS_R1_FAKE=
NEXT_PUBLIC_ROOMS_SEAL=

# Release 1: paid ticket types. Paid tickets need the Release 2 payment layer; with this on, a paid ticket type saves as far
# as the front end goes (the create page accepts prices), but nobody can buy one. Leave off until payments exist.
NEXT_PUBLIC_PAID_TICKETS=

# Release 1 paid tickets on Bachs (bachs.io), direct charge: every host connects their own Bachs account, Hoppaz takes a platform fee.
# Server only, never prefixed NEXT_PUBLIC. Names only here: the real values go in .env.local / the host, never in git.
# Sandbox key: sk_sandbox_..., base https://sandbox-api.bachs.io. Live key: sk_live_..., base https://api.bachs.io (needs Hoppaz's Connect review first).
BACHS_SECRET_KEY=
BACHS_API_BASE=https://sandbox-api.bachs.io
# Signing secret of the webhook endpoint (event_source "all") pointing at https://<site>/api/bachs/webhook. Created in the Bachs dashboard.
BACHS_WEBHOOK_SECRET=
# Optional. Bachs refuses a private or loopback success_url, so a laptop that talks to the real sandbox sets a public address here
# for the buyer's return. Unset: the site address (right for production, and for the local mock server).
BACHS_RETURN_ORIGIN=
# SET BY JAE: Hoppaz's cut of every paid ticket, inside the price the buyer sees (no extra line). fee = gross x percent + fixed.
# No default on purpose: with these unset, checkout and quote answer "Payments are not set up yet". Example only: 4.5 and 100.
HOPPAZ_TICKET_FEE_PERCENT=
HOPPAZ_TICKET_FEE_FIXED_NAIRA=
# Shared secret for /api/events-r1/pay/sweep (Authorization: Bearer <secret> or header x-hoppaz-cron-secret). Falls back to CRON_SECRET.
HOPPAZ_CRON_SECRET=
